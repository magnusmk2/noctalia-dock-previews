+void Dock::updateHoverPreview(shell::dock::DockInstance& instance) {
+  if (m_itemMenu != nullptr && !m_itemMenu->hoverPreview) {
+    return;
+  }
+  if (!instance.pointerInside || instance.drag.active || instance.drag.armed) {
+    instance.hoverPreviewTimer.stop();
+    instance.hoverPreviewIndex.reset();
+    return;
+  }
+  InputArea* hovered = instance.inputDispatcher.hoveredArea();
+  const auto it = std::ranges::find_if(instance.items, [hovered](const auto& item) { return item.area == hovered; });
+  if (it == instance.items.end() || !it->action.has_value()) {
+    instance.hoverPreviewTimer.stop();
+    instance.hoverPreviewIndex.reset();
+    if (m_itemMenu != nullptr && m_itemMenu->hoverPreview && m_popupOwnerInstance == &instance) {
+      instance.hoverPreviewSwitchPending = true;
+      closeItemMenu();
+    }
+    return;
+  }
+  const std::size_t index = static_cast<std::size_t>(std::distance(instance.items.begin(), it));
+  if (instance.hoverPreviewIndex == index) {
+    return;
+  }
+  instance.hoverPreviewTimer.stop();
+  instance.hoverPreviewIndex = index;
+  const auto action = *it->action;
+  if (m_itemMenu != nullptr) {
+    if (m_popupOwnerInstance == &instance && m_itemMenu->sourceDockItemIndex == index) {
+      return;
+    }
+    instance.hoverPreviewSwitchPending = false;
+    if (m_popupOwnerInstance != &instance) {
+      closeItemMenu();
+    }
+    if (m_itemMenu == nullptr) {
+      // Switching between icons can pass through the dock's gaps. Preserve the
+      // immediate handoff even though the previous popup was dismissed there.
+      instance.hoverPreviewSwitchPending = true;
+    } else {
+      DeferredCall::callLater([this, owner = &instance, index, action]() {
+        if (owner != m_hoveredInstance || !owner->pointerInside || m_itemMenu == nullptr
+            || !m_itemMenu->hoverPreview || index >= owner->items.size()
+            || owner->inputDispatcher.hoveredArea() != owner->items[index].area) {
+          return;
+        }
+        openWindowPreview(*owner, action, index);
+      });
+      return;
+    }
+  }
+  if (instance.hoverPreviewSwitchPending) {
+    instance.hoverPreviewSwitchPending = false;
+    DeferredCall::callLater([this, owner = &instance, index, action]() {
+      if (owner != m_hoveredInstance || !owner->pointerInside || m_itemMenu != nullptr
+          || index >= owner->items.size() || owner->inputDispatcher.hoveredArea() != owner->items[index].area) {
+        return;
+      }
+      openWindowPreview(*owner, action, index);
+    });
+    return;
+  }
+  instance.hoverPreviewTimer.start(std::chrono::milliseconds(850), [this, owner = &instance, index, action]() {
+    if (owner != m_hoveredInstance
+        || !owner->pointerInside
+        || m_itemMenu != nullptr
+        || index >= owner->items.size()
+        || owner->inputDispatcher.hoveredArea() != owner->items[index].area) {
+      return;
+    }
+    openWindowPreview(*owner, action, index);
+  });
+}
