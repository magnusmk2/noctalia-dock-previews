+void Dock::openWindowPreview(
+    shell::dock::DockInstance& instance, const shell::dock::DockItemAction& action, std::size_t itemIndex
+) {
+  assertDockInitialized(m_platform, m_config, m_renderContext);
+  closeItemMenu();
+  auto windows = shell::dock::windowsForDockItem(
+      *m_platform, action.windowLookupIdLower, action.windowLookupWmClassLower,
+      shell::dock::dockFilterOutput(instance.config, instance.output)
+  );
+  if (windows.empty()) {
+    return;
+  }
+  float anchorCenterX = static_cast<float>(m_platform->lastPointerX());
+  float anchorCenterY = static_cast<float>(m_platform->lastPointerY());
+  if (itemIndex < instance.items.size() && instance.items[itemIndex].area != nullptr) {
+    float areaX = 0.0F;
+    float areaY = 0.0F;
+    Node::absolutePosition(instance.items[itemIndex].area, areaX, areaY);
+    anchorCenterX = areaX + instance.items[itemIndex].area->width() * 0.5F;
+    anchorCenterY = areaY + instance.items[itemIndex].area->height() * 0.5F;
+  }
+  m_popupOwnerInstance = &instance;
+  auto* layerSurface =
+      instance.surface != nullptr ? m_platform->layerSurfaceFor(instance.surface->wlSurface()) : nullptr;
+  m_itemMenu = shell::dock::createWindowPreview(
+      *m_platform, *m_config, *m_renderContext, layerSurface, instance.output, instance.config, anchorCenterX,
+      anchorCenterY, action.entry, std::move(windows),
+      [this](std::size_t index) {
+        if (m_platform != nullptr && m_itemMenu != nullptr && index < m_itemMenu->windows.size()) {
+          m_platform->activateToplevelInfo(m_itemMenu->windows[index]);
+        }
+      },
+      [this](std::size_t index) {
+        if (m_platform != nullptr && m_itemMenu != nullptr && index < m_itemMenu->windows.size()) {
+          m_platform->closeToplevelInfo(m_itemMenu->windows[index]);
+        }
+      },
+      [this]() { closeItemMenu(); }
+  );
+  if (m_itemMenu != nullptr) {
+    m_itemMenu->sourceDockItemIndex = itemIndex;
+  }
+  if (m_itemMenu == nullptr) {
+    m_popupOwnerInstance = nullptr;
+  }
+}
